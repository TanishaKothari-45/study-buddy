# ═══════════════════════════════════════════════════════════════════════════════
# Study Buddy GCP Deployment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to config.env and fill in your values:
#   cp config.env.example config.env
#
# IMPORTANT: Never commit config.env to version control!
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# PROJECT SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# Your GCP Project ID (must be globally unique)
PROJECT_ID="study-buddy-prod"

# Region for deployment (asia-south1 = Mumbai)
REGION="asia-south1"

# Billing account ID (run: gcloud billing accounts list)
BILLING_ACCOUNT_ID=""

# ═══════════════════════════════════════════════════════════════════════════════
# SERVICE ACCOUNT
# ═══════════════════════════════════════════════════════════════════════════════

# Service account name (will be created as: name@project.iam.gserviceaccount.com)
SA_NAME="study-buddy-backend"

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUD SQL (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════════════════

# Instance name
SQL_INSTANCE="study-buddy-db"

# Database name
SQL_DATABASE="studybuddy"

# Database user
SQL_USER="studybuddy_user"

# Instance tier (db-f1-micro = cheapest, ~$10/month)
# Options: db-f1-micro, db-g1-small, db-custom-1-3840, db-custom-2-7680
SQL_TIER="db-f1-micro"

# Storage size in GB (will auto-increase)
SQL_STORAGE_SIZE="10"

# PostgreSQL version
SQL_VERSION="POSTGRES_15"

# ═══════════════════════════════════════════════════════════════════════════════
# MEMORYSTORE (Redis)
# ═══════════════════════════════════════════════════════════════════════════════

# Redis instance name
REDIS_INSTANCE="study-buddy-redis"

# Redis size in GB (1, 2, 5, etc.)
REDIS_SIZE="1"

# Redis version
REDIS_VERSION="redis_7_0"

# Redis tier (basic = no HA, standard = with HA replica)
REDIS_TIER="basic"

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUD STORAGE (GCS)
# ═══════════════════════════════════════════════════════════════════════════════

# Bucket name (must be globally unique, will append project ID)
GCS_BUCKET_PREFIX="study-buddy-uploads"

# Storage class (STANDARD, NEARLINE, COLDLINE, ARCHIVE)
GCS_STORAGE_CLASS="STANDARD"

# ═══════════════════════════════════════════════════════════════════════════════
# VPC NETWORKING
# ═══════════════════════════════════════════════════════════════════════════════

# VPC connector name
VPC_CONNECTOR="study-buddy-connector"

# VPC network to use
VPC_NETWORK="default"

# IP range for VPC connector (must be /28, not overlapping)
VPC_IP_RANGE="10.8.0.0/28"

# ═══════════════════════════════════════════════════════════════════════════════
# ARTIFACT REGISTRY
# ═══════════════════════════════════════════════════════════════════════════════

# Docker repository name
ARTIFACT_REPO="study-buddy"

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUD RUN SERVICES
# ═══════════════════════════════════════════════════════════════════════════════

# API service settings
API_SERVICE_NAME="study-buddy-api"
API_MEMORY="2Gi"
API_CPU="2"
API_TIMEOUT="300"
API_MIN_INSTANCES="0"
API_MAX_INSTANCES="10"

# Worker service settings
WORKER_SERVICE_NAME="study-buddy-worker"
WORKER_MEMORY="2Gi"
WORKER_CPU="2"
WORKER_TIMEOUT="900"
WORKER_MIN_INSTANCES="1"
WORKER_MAX_INSTANCES="3"

# ═══════════════════════════════════════════════════════════════════════════════
# PINECONE (External Service)
# ═══════════════════════════════════════════════════════════════════════════════

# Pinecone index name
PINECONE_INDEX_NAME="study-buddy"

# ═══════════════════════════════════════════════════════════════════════════════
# API KEYS (Leave empty - will be prompted interactively)
# ═══════════════════════════════════════════════════════════════════════════════
# These are intentionally left empty for security.
# The scripts will prompt you to enter them securely at runtime.

# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# PINECONE_API_KEY=""
