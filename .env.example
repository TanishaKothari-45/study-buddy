# Study Buddy AI - Environment Variables

# ============================================
# REQUIRED VARIABLES (App will not start without these)
# ============================================

# JWT Authentication (CRITICAL - Generate a secure random string)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-CHANGE-THIS

# OpenAI API (for embeddings and mock test generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API (for mains answers and evaluation)
GEMINI_API_KEY=your-gemini-api-key-here

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=study-buddy

# ============================================
# OPTIONAL VARIABLES (Features work without these)
# ============================================

# News APIs for Current Affairs (at least one recommended)
GNEWS_API_KEY=your-gnews-api-key
NEWS_API_KEY=your-newsapi-key
THENEWSAPI_KEY=your-thenewsapi-key

# Email Notifications (optional)
EMAIL_ENABLED=false
GMAIL_APP_PASSWORD=your-gmail-app-password

# ============================================
# APPLICATION SETTINGS (Defaults are fine)
# ============================================

# Vector Store Selection
USE_PINECONE=true  # Set to false to use ChromaDB instead

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model Selection
LLM_MODEL_SMALL=gpt-4o-mini
LLM_MODEL_LARGE=gpt-4o
GEMINI_MODEL_PRO=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-3-small

# Redis Cache (for answer and news caching)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Optional, leave empty if no auth

# Database
DATABASE_URL=sqlite:///./data/databases/sql_app.db

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate a secure JWT secret:
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Add your API keys from:
#    - OpenAI: https://platform.openai.com/api-keys
#    - Gemini: https://aistudio.google.com/app/apikey
#    - Pinecone: https://app.pinecone.io/
# 4. (Optional) Add news API keys for current affairs integration

SUPABASE_JWT_SECRET=eyvcjhdsvcie8dyew87gdievducd...
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eydcvysdf6c7sycdsycvdycv...